\f4\b\fs44 \AppleTypeServices\AppleTypeServicesF65539 \cf2 \strokec2 4. Mathematical & Metabolic Engine\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \AppleTypeServices \cf3 \strokec3 Baseline metabolic targets and macronutrient distributions are calculated deterministically to guarantee accuracy and eliminate AI hallucinations.\
\pard\pardeftab720\sa360\partightenfactor0

\f5\b\fs36 \AppleTypeServices\AppleTypeServicesF65539 \cf2 \strokec2 Basal Metabolic Rate (BMR)\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \AppleTypeServices \cf3 \strokec3 Calculated via the Mifflin-St Jeor formula:\
\pard\pardeftab720\partightenfactor0

\f6\b \cf3 \cb5 BMR (male)
\f7\b0  = 10 \'b7 W + 6.25 \'b7 H - 5 \'b7 A + 5\cb1 \

\f6\b \cb5 BMR (female)
\f7\b0  = 10 \'b7 W + 6.25 \'b7 H - 5 \'b7 A - 161\
\pard\pardeftab720\sa240\partightenfactor0

\f2 \cf3 \cb1 Where 
\f3\i W
\f2\i0  = weight in kg, 
\f3\i H
\f2\i0  = height in cm, 
\f3\i A
\f2\i0  = age in years.\
\pard\pardeftab720\sa360\partightenfactor0

\f5\b\fs36 \AppleTypeServices\AppleTypeServicesF65539 \cf2 \strokec2 Total Daily Energy Expenditure (TDEE)\
\pard\pardeftab720\partightenfactor0

\f6\fs24 \AppleTypeServices \cf3 \cb5 \strokec3 TDEE
\f7\b0  = BMR \'b7 \uc0\u945 
\fs20 \sub activity
\fs24 \nosupersub \
\pard\pardeftab720\sa240\partightenfactor0

\f2 \cf3 \cb1 Where \uc0\u945 
\fs20 \sub activity
\fs24 \nosupersub  ranges from 1.200 (sedentary) to 1.900 (extreme activity).\
\pard\pardeftab720\sa360\partightenfactor0

\f5\b\fs36 \AppleTypeServices\AppleTypeServicesF65539 \cf2 \strokec2 Macronutrient Targets\
\pard\pardeftab720\partightenfactor0

\f6\fs24 \AppleTypeServices \cf3 \cb5 \strokec3 Calories (target)
\f7\b0  = Deficit (Fat Loss: 0.82 \'b7 TDEE, Min 1200-1500) | Surplus (Muscle: 1.10 \'b7 TDEE)\cb1 \

\f6\b \cb5 Protein (grams)
\f7\b0  = clamp(W \'b7 \uc0\u946 
\fs20 \sub protein
\fs24 \nosupersub , 60, 240) where \uc0\u946 
\fs20 \sub protein
\fs24 \nosupersub  = 1.4 - 2.0 g/kg\
\pard\pardeftab720\partightenfactor0

